<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="azk_dynamic_trial_balance.TrialBalanceFilters" t-inherit="account_reports.AccountReportFiltersCustomizable">
        <xpath expr="//div[@id='filter_extra_options']" position="before">
            <div class="azk-tb-filters d-flex flex-wrap align-items-center gap-3 ms-1">
                <input type="text"
                       class="form-control form-control-sm azk-tb-prefixes"
                       style="width: 11rem;"
                       placeholder="Accounts: e.g. 1, 40"
                       title="Account code prefixes, separated by commas. Press Enter to apply."
                       t-att-value="this.azkPrefixes"
                       t-on-change="(ev) => this.azkSetPrefixes(ev)"
                       t-on-keydown="(ev) => ev.key === 'Enter' and this.azkSetPrefixes(ev)"/>
                <t t-foreach="this.azkSwitches" t-as="item" t-key="item.key">
                    <div t-attf-class="form-check form-switch mb-0 text-nowrap azk-tb-toggle-{{ item.key }}">
                        <input class="form-check-input" type="checkbox"
                               t-att-id="'azk_tb_' + item.key"
                               t-att-checked="item.value"
                               t-on-change="() => this.azkToggle(item)"/>
                        <label class="form-check-label" t-att-for="'azk_tb_' + item.key" t-out="item.label"/>
                    </div>
                    <select t-if="item.key === 'only_parents' and item.value"
                            class="form-select form-select-sm azk-tb-level w-auto"
                            title="Account level up to"
                            t-on-change="(ev) => this.azkSetLevel(ev)">
                        <t t-foreach="this.azkLevels" t-as="level" t-key="level">
                            <option t-att-value="level" t-att-selected="level === this.azkTb.account_level" t-out="level"/>
                        </t>
                    </select>
                </t>
            </div>
        </xpath>
    </t>
</templates>
