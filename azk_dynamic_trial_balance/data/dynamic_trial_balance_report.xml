<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <record id="dynamic_trial_balance_report" model="account.report">
        <field name="name">Dynamic Trial Balance</field>
        <field name="groupby">account_id</field>
        <field name="filter_journals" eval="False"/>
        <field name="filter_analytic_groupby" eval="False"/>
        <field name="filter_growth_comparison" eval="False"/>
        <field name="filter_multi_company">selector</field>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_hierarchy">by_default</field>
        <field name="filter_show_draft" eval="True"/>
        <field name="filter_hide_0_lines">never</field>
        <field name="default_opening_date_filter">this_month</field>
        <field name="search_bar" eval="True"/>
        <field name="custom_handler_model_id" ref="model_azk_dynamic_trial_balance_report_handler"/>
        <field name="column_ids">
            <record id="dynamic_trial_balance_report_debit" model="account.report.column">
                <field name="name">Debit</field>
                <field name="expression_label">debit</field>
            </record>
            <record id="dynamic_trial_balance_report_credit" model="account.report.column">
                <field name="name">Credit</field>
                <field name="expression_label">credit</field>
            </record>
            <record id="dynamic_trial_balance_report_balance" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="dynamic_trial_balance_report_line" model="account.report.line">
                <field name="name">Dynamic Trial Balance</field>
                <field name="code">AZK_DTB</field>
                <field name="foldability">always_unfolded</field>
                <field name="expression_ids">
                    <record id="dynamic_trial_balance_report_line_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">custom</field>
                        <field name="auditable">True</field>
                        <field name="formula">_report_engine_trial_balance</field>
                        <field name="subformula">balance</field>
                    </record>
                    <record id="dynamic_trial_balance_report_line_debit" model="account.report.expression">
                        <field name="label">debit</field>
                        <field name="engine">custom</field>
                        <field name="auditable">True</field>
                        <field name="formula">_report_engine_trial_balance</field>
                        <field name="subformula">debit</field>
                    </record>
                    <record id="dynamic_trial_balance_report_line_credit" model="account.report.expression">
                        <field name="label">credit</field>
                        <field name="engine">custom</field>
                        <field name="auditable">True</field>
                        <field name="formula">_report_engine_trial_balance</field>
                        <field name="subformula">credit</field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
