<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Salesperson printed under the product name (uses the native extra-info hook,
         so any receipt layout re-using this template shows it too). -->
    <template id="pos_orderline_receipt_information_salesperson" inherit_id="point_of_sale.pos_orderline_receipt_information">
        <xpath expr="//div[@name='extra-info']" position="inside">
            <div t-if="conditions.get('azk_salesperson') and line.get('salesperson_name')" class="azk-salesperson text-small">
                Salesperson: <span t-out="line['salesperson_name']"/>
            </div>
        </xpath>
    </template>
</odoo>
