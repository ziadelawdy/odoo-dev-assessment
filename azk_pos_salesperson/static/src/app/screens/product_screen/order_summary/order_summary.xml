<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Per-line salesperson icon: rendered in the Orderline default slot,
         so it only appears on the product screen. -->
    <t t-name="azk_pos_salesperson.OrderSummary" t-inherit="point_of_sale.OrderSummary" t-inherit-mode="extension">
        <xpath expr="//Orderline" position="inside">
            <li t-if="this.pos.config.active_salesperson_feature" class="azk-salesperson-line d-flex align-items-center gap-2">
                <button class="azk-salesperson-btn btn btn-link p-0 text-decoration-none"
                        title="Assign salesperson" aria-label="Assign salesperson"
                        t-on-pointerdown.stop="() => {}"
                        t-on-pointerup.stop="() => {}"
                        t-on-click.stop="() => this.azkAssignLineSalesperson(line)">
                    <i class="fa fa-user-plus" aria-hidden="true"/>
                </button>
                <span t-if="line.salesperson_id" class="azk-salesperson-name" t-out="line.salesperson_id.name"/>
            </li>
        </xpath>
    </t>
</templates>
