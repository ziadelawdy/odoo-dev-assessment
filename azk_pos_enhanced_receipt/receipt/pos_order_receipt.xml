<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Header (design A): company block, dashed rule, order block (ticket,
         date, cashier), customer, dashed rule. The native ticket, cashier and
         customer blocks are replaced. Tables, not flexbox: the email image is
         rendered by wkhtmltoimage. -->
    <template id="pos_order_receipt_header_enhanced" inherit_id="point_of_sale.pos_order_receipt_header">
        <xpath expr="//div[@name='logo']" position="after">
            <t t-if="conditions.get('azk_enhanced')">
                <div class="azk-company w-100 text-center">
                    <div t-if="extra_data.get('azk_company_name')" class="azk-company-name" t-out="extra_data['azk_company_name']"/>
                    <div t-if="extra_data.get('azk_company_details')" class="azk-company-details azk-muted" t-out="extra_data['azk_company_details']"/>
                    <!-- The footer company block is hidden in enhanced mode: keep the legal tax ID here. -->
                    <div t-if="company.get('vat')" class="azk-company-vat azk-muted">
                        <t t-out="extra_data.get('vat_label') or 'Tax ID'"/>: <t t-out="company['vat']"/>
                    </div>
                </div>
                <hr class="azk-sep"/>
                <table class="azk-order-info w-100">
                    <tr>
                        <td class="text-start">
                            <span name="ticket">Ticket</span> <t t-if="conditions['display_vat']">VAT </t><t t-out="order['pos_reference']"/>
                        </td>
                        <td class="text-end" t-out="extra_data['formated_date_order']"/>
                    </tr>
                    <tr t-if="extra_data['cashier_name']">
                        <td class="text-start azk-muted">Cashier</td>
                        <td class="text-end" t-out="extra_data['cashier_name']"/>
                    </tr>
                </table>
                <div t-if="conditions.get('azk_show_customer') and extra_data.get('azk_customer')" class="azk-customer w-100 text-start">
                    <div><span class="azk-muted">Customer:</span> <strong t-out="extra_data['azk_customer']['name']"/></div>
                    <div t-foreach="extra_data['azk_customer']['address_lines']" t-as="address_line" class="azk-muted" t-out="address_line"/>
                </div>
                <hr class="azk-sep"/>
            </t>
        </xpath>
        <xpath expr="//div[@name='ticket_reference']/.." position="attributes">
            <attribute name="t-if">not conditions.get('azk_enhanced')</attribute>
        </xpath>
        <xpath expr="//div[@name='cashier_name']" position="attributes">
            <attribute name="t-if" add="not conditions.get('azk_enhanced')" separator=" and "/>
        </xpath>
        <xpath expr="//div[@name='partner_info']" position="attributes">
            <attribute name="t-if">not conditions.get('azk_enhanced')</attribute>
        </xpath>
        <!-- The payment screen preview renders the draft order: no "Pro forma" label there. -->
        <xpath expr="//div[@name='pro_forma_receipt']" position="attributes">
            <attribute name="t-if" add="not conditions.get('azk_preview')" separator=" and "/>
        </xpath>
    </template>

    <!-- Lines: one table (Product | Qty | Price | Total) instead of the per-line tables. -->
    <template id="pos_order_receipt_enhanced" inherit_id="point_of_sale.pos_order_receipt">
        <xpath expr="//table[@t-foreach='lines']" position="attributes">
            <attribute name="t-if">not conditions.get('azk_enhanced')</attribute>
        </xpath>
        <xpath expr="//table[@t-foreach='lines']" position="after">
            <table t-if="conditions.get('azk_enhanced')" class="azk-lines-table w-100">
                <thead>
                    <tr>
                        <th class="text-start">Product</th>
                        <th class="text-end azk-num">Qty</th>
                        <th t-if="not conditions['basic_receipt']" class="text-end azk-num">Price</th>
                        <th t-if="not conditions['basic_receipt']" class="text-end azk-num">Total</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="lines" t-as="line" class="azk-line" t-att-class="{'azk-combo-child': line['combo_parent_id']}">
                        <td class="text-start top azk-product-cell">
                            <t t-set="azk_table_mode" t-value="True"/>
                            <t t-call="point_of_sale.pos_orderline_receipt_information"/>
                        </td>
                        <td class="text-end top azk-num" t-out="line['qty']"/>
                        <t t-if="not conditions['basic_receipt']">
                            <td class="text-end top azk-num">
                                <t t-if="not line['combo_parent_id'] and not line['is_service_fee_line']" t-out="line['unit_price']"/>
                            </td>
                            <td class="text-end top azk-num azk-line-total">
                                <t t-if="not line['combo_parent_id']" t-out="line['price_subtotal_incl']"/>
                            </td>
                        </t>
                    </tr>
                </tbody>
            </table>
        </xpath>
        <!-- Dashed rules before the totals and before the footer. -->
        <xpath expr="//div[@name='prices']" position="before">
            <hr t-if="conditions.get('azk_enhanced')" class="azk-sep"/>
        </xpath>
        <xpath expr="//div[@name='before-footer']" position="after">
            <hr t-if="conditions.get('azk_enhanced')" class="azk-sep"/>
        </xpath>
    </template>

    <!-- The unit price lives in the Price column of the table. -->
    <template id="pos_orderline_receipt_information_enhanced" inherit_id="point_of_sale.pos_orderline_receipt_information">
        <xpath expr="//span[@name='standard-unit-price']" position="attributes">
            <attribute name="t-if" add="not azk_table_mode" separator=" and "/>
        </xpath>
    </template>

    <!-- Receipt styles: the receipt is rendered in its own document, styled by this template. -->
    <template id="pos_order_receipt_style_enhanced" inherit_id="point_of_sale.pos_order_receipt_style">
        <xpath expr="//style" position="inside">
            .azk-sep { border: 0; border-top: 1px dashed #000; margin: 8px 0; height: 0; }
            .azk-muted { color: #555; }
            .azk-company { margin-bottom: 4px; }
            .azk-company-name { font-size: 1.3em; font-weight: bold; line-height: 1.25; }
            .azk-company-details, .azk-company-vat { font-size: 0.85em; }
            .azk-company-name p, .azk-company-details p { margin: 0; }
            .azk-order-info { border-collapse: collapse; font-size: 0.85em; }
            .azk-order-info td { padding: 1px 0; vertical-align: top; }
            .azk-customer { font-size: 0.85em; margin-top: 4px; }
            .azk-lines-table { border-collapse: collapse; }
            .azk-lines-table th { border-bottom: 1px solid #000; padding: 2px 3px; font-weight: bold; font-size: 0.85em; }
            .azk-lines-table td { padding: 5px 3px; border-bottom: 1px dashed #bbb; vertical-align: top; }
            .azk-lines-table tr:last-child td { border-bottom: 0; }
            .azk-lines-table .azk-num { width: 1%; white-space: nowrap; }
            .azk-lines-table .azk-line-total { font-weight: bold; }
            .azk-lines-table .name { font-size: 1em; font-weight: bold; line-height: 1.3; }
            .azk-lines-table .azk-product-cell .text-small,
            .azk-lines-table .azk-product-cell .text-normal,
            .azk-lines-table .azk-product-cell div:not(.name) { font-size: 0.8em; color: #555; }
            .azk-lines-table .azk-combo-child .azk-product-cell { padding-left: 14px; }
            .azk-lines-table .azk-combo-child .name { font-weight: normal; }
        </xpath>
    </template>

    <!-- Company info is printed at the top in enhanced mode: hide the footer copy. -->
    <template id="pos_order_receipt_footer_enhanced" inherit_id="point_of_sale.pos_order_receipt_footer">
        <xpath expr="//t[@t-call='point_of_sale.company_info_receipt']" position="attributes">
            <attribute name="t-if">not conditions.get('azk_enhanced')</attribute>
        </xpath>
    </template>
</odoo>
